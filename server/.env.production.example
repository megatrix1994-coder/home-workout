# Copy to server/.env.production and replace every placeholder. Keep the copy out of git.
# Used by: docker compose --env-file server/.env.production -f docker-compose.prod.yml up -d --build
POSTGRES_USER=homeworkout
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=homeworkout
# The public address people open in a browser. Separate several with commas.
CORS_ORIGIN=http://localhost:8080
# The address used in invite and reset links. Use the HTTPS address in real use.
PUBLIC_URL=http://localhost:8080
# Set to 1 when a proxy or host terminates HTTPS in front of the app.
TRUST_PROXY=
# Session cookies are Secure in production. Set to false only for a plain-HTTP test on a
# machine other than localhost.
COOKIE_SECURE=
