generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MuscleGroup {
  id               String          @id @default(cuid())
  slug             String          @unique
  name             String
  anatomicalRegion String
  sortOrder        Int
  exercises        ExerciseMuscle[]
  stretches        StretchMuscle[]
  workouts         WorkoutPlan[]
  cooldowns        WorkoutCooldown[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([anatomicalRegion])
}

model Equipment {
  id        String              @id @default(cuid())
  slug      String              @unique
  name      String
  category  EquipmentCategory
  exercises ExerciseEquipment[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([category])
}

model Exercise {
  id           String              @id @default(cuid())
  slug         String              @unique
  name         String
  description  String
  instructions String
  difficulty   Difficulty
  movementType MovementType
  region       String
  goals        TrainingGoal[]
  muscles          ExerciseMuscle[]
  equipment        ExerciseEquipment[]
  stretches        ExerciseStretch[]
  animations       AnimationAsset[]
  workoutExercises WorkoutExercise[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([difficulty])
  @@index([name])
}

model ExerciseMuscle {
  exerciseId String
  muscleId   String
  role       MuscleRole
  exercise   Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscle     MuscleGroup @relation(fields: [muscleId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleId])
  @@index([muscleId])
}

model ExerciseEquipment {
  exerciseId  String
  equipmentId String
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([exerciseId, equipmentId])
  @@index([equipmentId])
}

model Stretch {
  id              String            @id @default(cuid())
  slug            String            @unique
  name            String
  instructions    String
  durationSeconds Int
  purpose         StretchPurpose    @default(warmup)
  muscles         StretchMuscle[]
  exercises       ExerciseStretch[]
  animations      AnimationAsset[]
  warmups         WorkoutWarmup[]
  cooldowns       WorkoutCooldown[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model StretchMuscle {
  stretchId String
  muscleId  String
  stretch   Stretch     @relation(fields: [stretchId], references: [id], onDelete: Cascade)
  muscle    MuscleGroup @relation(fields: [muscleId], references: [id], onDelete: Cascade)

  @@id([stretchId, muscleId])
}

model ExerciseStretch {
  exerciseId String
  stretchId  String
  relevance  String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  stretch    Stretch  @relation(fields: [stretchId], references: [id], onDelete: Cascade)

  @@id([exerciseId, stretchId])
}

model AnimationAsset {
  id           String          @id @default(cuid())
  exerciseId   String?
  stretchId    String?
  assetUrl     String
  format       AnimationFormat
  reviewStatus ReviewStatus    @default(draft)
  exercise     Exercise?       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  stretch      Stretch?        @relation(fields: [stretchId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([exerciseId])
  @@index([stretchId])
}

model WorkoutPlan {
  id                  String             @id @default(cuid())
  muscleId            String
  goal                TrainingGoal
  experience          ExperienceLevel
  equipmentCategories EquipmentCategory[]
  rationale           String
  estimatedMinutes    Int                @default(0)
  rounds              Int                @default(1)
  status              WorkoutStatus      @default(draft)
  startedAt           DateTime?
  completedAt         DateTime?
  muscle              MuscleGroup        @relation(fields: [muscleId], references: [id], onDelete: Restrict)
  exercises           WorkoutExercise[]
  warmups             WorkoutWarmup[]
  cooldowns           WorkoutCooldown[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([muscleId])
  @@index([status])
}

model WorkoutExercise {
  id          String      @id @default(cuid())
  workoutId   String
  exerciseId  String
  order       Int
  sets        Int
  reps        String
  restSeconds Int
  reason      String
  workout     WorkoutPlan @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setLogs     WorkoutSetLog[]

  @@unique([workoutId, order])
  @@unique([workoutId, exerciseId])
  @@index([exerciseId])
}

model WorkoutWarmup {
  id              String      @id @default(cuid())
  workoutId       String
  stretchId       String
  order           Int
  durationSeconds Int
  workout         WorkoutPlan @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  stretch         Stretch     @relation(fields: [stretchId], references: [id], onDelete: Cascade)

  @@unique([workoutId, order])
  @@unique([workoutId, stretchId])
  @@index([stretchId])
}

model WorkoutCooldown {
  id              String         @id @default(cuid())
  workoutId       String
  stretchId       String
  muscleId        String
  order           Int
  durationSeconds Int
  status          CooldownStatus @default(pending)
  workout         WorkoutPlan    @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  stretch         Stretch        @relation(fields: [stretchId], references: [id], onDelete: Cascade)
  muscle          MuscleGroup    @relation(fields: [muscleId], references: [id], onDelete: Cascade)

  @@unique([workoutId, order])
  @@unique([workoutId, muscleId])
  @@index([stretchId])
}

enum StretchPurpose {
  warmup
  cooldown
}

enum CooldownStatus {
  pending
  completed
  skipped
}

enum EquipmentCategory {
  free_weight
  machine
  bodyweight
}

enum TrainingGoal {
  strength
  hypertrophy
  general_fitness
  endurance
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum WorkoutStatus {
  draft
  started
  completed
}

model WorkoutSetLog {
  id                String          @id @default(cuid())
  workoutExerciseId String
  round             Int
  setNumber         Int
  repsCompleted     Int
  weightKg          Float?
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([workoutExerciseId, round, setNumber])
  @@index([workoutExerciseId])
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum MuscleRole {
  primary
  secondary
}

enum MovementType {
  compound
  isolation
  isometric
}

enum AnimationFormat {
  lottie
  video
  image
}

enum ReviewStatus {
  draft
  approved
}

enum FoodRegion {
  local
  international
}

enum BudgetBand {
  low
  moderate
}

enum MealTiming {
  pre
  post
}

enum DietPattern {
  vegetarian
  vegan
}

enum NutrientName {
  energy
  protein
  carbohydrate
  fat
}

enum MealEmphasis {
  carbohydrate
  protein
  mixed
}

enum Allergen {
  milk
  egg
  peanut
  fish
  soy
  gluten
  tree_nut
}

model Food {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  region      FoodRegion
  servingSize String
  preparation String
  allergens   Allergen[]
  diets       DietPattern[]
  nutrients   FoodNutrient[]
  meals       MealFood[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model FoodNutrient {
  id         String       @id @default(cuid())
  foodId     String
  nutrient   NutrientName
  amount     Float
  unit       String
  sourceName String
  food       Food         @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, nutrient])
  @@index([foodId])
}

model Meal {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  timing      MealTiming
  region      FoodRegion
  rationale   String
  prepMinutes Int
  budget      BudgetBand
  emphasis    MealEmphasis
  foods       MealFood[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([timing])
  @@index([region])
}

model MealFood {
  mealId String
  foodId String
  order  Int
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([mealId, foodId])
  @@unique([mealId, order])
}
